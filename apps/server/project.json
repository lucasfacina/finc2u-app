{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "server",
  "projectType": "application",
  "metadata": {
    "targetGroups": {
      "Server": [
        "dev",
        "test",
        "build",
        "verify",
        "clean"
      ],
      "Database": [
        "db:h2:reset",
        "db:h2:fresh"
      ]
    }
  },
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./mvnw spring-boot:run -Dspring-boot.run.workingDirectory=\"$(cd ../.. && pwd)\"",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./mvnw test",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./mvnw package -DskipTests",
        "cwd": "{projectRoot}"
      }
    },
    "verify": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./mvnw verify",
        "cwd": "{projectRoot}"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./mvnw clean",
        "cwd": "{projectRoot}"
      }
    },
    "db:h2:reset": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./scripts/db-reset.sh",
        "cwd": "{workspaceRoot}"
      }
    },
    "db:h2:fresh": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "./scripts/db-reset.sh --yes",
          "nx run server:dev"
        ],
        "parallel": false,
        "forwardAllArgs": false,
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
