{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "server",
  "projectType": "application",
  "metadata": {
    "targetGroups": {
      "Server": [
        "dev",
        "test",
        "build",
        "verify",
        "clean",
        "deps:updates",
        "deps:audit",
        "api:export"
      ],
      "Database": [
        "db:h2:reset",
        "db:h2:fresh",
        "db:pg:start",
        "db:pg:stop",
        "db:pg:status",
        "db:pg:logs",
        "db:pg:psql",
        "db:pg:reset",
        "db:pg:backup",
        "db:pg:restore",
        "db:pg:schema",
        "db:flyway:info",
        "db:flyway:validate",
        "db:flyway:migrate"
      ]
    }
  },
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./mvnw spring-boot:run -Dspring-boot.run.workingDirectory=\"$(cd ../.. && pwd)\"",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./mvnw test",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./mvnw package -DskipTests",
        "cwd": "{projectRoot}"
      }
    },
    "verify": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./mvnw verify",
        "cwd": "{projectRoot}"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./mvnw clean",
        "cwd": "{projectRoot}"
      }
    },
    "db:h2:reset": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./scripts/db-reset.sh",
        "cwd": "{workspaceRoot}"
      }
    },
    "db:h2:fresh": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "./scripts/db-reset.sh --yes",
          "nx run server:dev"
        ],
        "parallel": false,
        "forwardAllArgs": false,
        "cwd": "{workspaceRoot}"
      }
    },
    "db:pg:start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose up -d",
        "cwd": "{workspaceRoot}"
      }
    },
    "db:pg:stop": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose stop postgres",
        "cwd": "{workspaceRoot}"
      }
    },
    "db:pg:status": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose ps",
        "cwd": "{workspaceRoot}"
      }
    },
    "db:pg:logs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose logs -f postgres",
        "cwd": "{workspaceRoot}"
      }
    },
    "db:pg:psql": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./scripts/pg-psql.sh",
        "cwd": "{workspaceRoot}"
      }
    },
    "db:pg:reset": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./scripts/pg-reset.sh",
        "cwd": "{workspaceRoot}"
      }
    },
    "db:pg:backup": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./scripts/pg-backup.sh",
        "cwd": "{workspaceRoot}"
      }
    },
    "db:pg:restore": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./scripts/pg-restore.sh",
        "cwd": "{workspaceRoot}"
      }
    },
    "db:pg:schema": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./scripts/pg-schema.sh",
        "cwd": "{workspaceRoot}"
      }
    },
    "db:flyway:info": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./scripts/flyway.sh info",
        "cwd": "{workspaceRoot}"
      }
    },
    "db:flyway:validate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./scripts/flyway.sh validate",
        "cwd": "{workspaceRoot}"
      }
    },
    "db:flyway:migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./scripts/flyway.sh migrate",
        "cwd": "{workspaceRoot}"
      }
    },
    "deps:updates": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./scripts/deps-updates.sh",
        "cwd": "{workspaceRoot}"
      }
    },
    "deps:audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./scripts/deps-audit.sh",
        "cwd": "{workspaceRoot}"
      }
    },
    "api:export": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./scripts/api-export.sh",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
